# ─────────────────────────────────────────────────────────────────────────────
# Mi-Reli environment template
# Copy to .env and fill in. Nothing here is required to run in demo mode.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database (relative to project root)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── M-Pesa Daraja (Safaricom) ────────────────────────────────────────────────
# Leave MPESA_MODE unset (or "auto") to run in demo mode: payments are
# simulated, receipts are generated locally, paybill option hides itself.
# Uncomment the block below and paste your production credentials to go live —
# zero code changes needed. Also editable at runtime via Admin → Payments.

# MPESA_MODE=live
# MPESA_ENVIRONMENT=production
# MPESA_CONSUMER_KEY=your_consumer_key
# MPESA_CONSUMER_SECRET=your_consumer_secret
# MPESA_SHORTCODE=your_paybill_or_shortcode
# MPESA_PASSKEY=your_online_passkey
# Public HTTPS base URL that Daraja can reach for callbacks, e.g.
# https://yourdomain.com
# MPESA_CALLBACK_BASE_URL=
# B2C payouts (driver weekly payouts + refunds). Needed when refunds fall
# outside the 24h reversal window.
# MPESA_B2C_SHORTCODE=
# MPESA_INITIATOR_NAME=
# MPESA_INITIATOR_PASSWORD=
# MPESA_SECURITY_CREDENTIAL=
# Path to the Daraja public certificate (PEM) for B2C security credential
# encryption. Optional depending on credential type.
# MPESA_CERT=
