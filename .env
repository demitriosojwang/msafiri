DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── M-Pesa Daraja (optional — Admin → Payments saves the same values) ───────
# Environment variables override the admin console. Leave commented until your
# Safaricom credentials arrive; the platform then switches to live mode by
# itself. Set MPESA_MODE=mock to force demo simulation even with credentials.
#
# MPESA_ENVIRONMENT=sandbox            # sandbox | production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=                     # collection paybill number
# MPESA_PASSKEY=                       # Lipa na M-Pesa Online passkey
# MPESA_CALLBACK_BASE_URL=             # e.g. https://mireli.co.ke
# MPESA_B2C_SHORTCODE=                 # optional, defaults to MPESA_SHORTCODE
# MPESA_INITIATOR_NAME=                # API operator for B2C / Reversal
# MPESA_INITIATOR_PASSWORD=
# MPESA_SECURITY_CREDENTIAL=           # or a pre-encrypted credential
# MPESA_CERT=                          # Safaricom public certificate (PEM)
# MPESA_MODE=                          # "mock" forces the demo simulator
