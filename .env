DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── M-Pesa Daraja (passenger payment system) ────────────────────────────────
# Paste your Daraja credentials here when they arrive — no code changes needed.
# The moment Consumer Key + Secret + Shortcode + Passkey are set, every fare
# collection (STK push), paybill confirmation, refund and payout goes LIVE.
# Remove the leading "# " from each line you fill in. Leave blank to stay in
# the built-in demo simulation.
#
# MPESA_MODE=                # leave empty for auto; set to "mock" to force demo even with credentials
# MPESA_ENVIRONMENT=sandbox  # sandbox | production
# MPESA_CONSUMER_KEY=        # Daraja app consumer key
# MPESA_CONSUMER_SECRET=     # Daraja app consumer secret
# MPESA_SHORTCODE=           # collection (head) shortcode — passenger fares land here
# MPESA_PASSKEY=             # Lipa na M-Pesa Online passkey
# MPESA_CALLBACK_BASE_URL=   # public https base, e.g. https://mireli.co.ke
# MPESA_B2C_SHORTCODE=       # initiator shortcode for refunds/driver payouts (optional)
# MPESA_INITIATOR_NAME=      # API operator username for B2C/reversal (optional)
# MPESA_INITIATOR_PASSWORD=  # plain initiator password (encrypted with the Safaricom cert at call time)
# MPESA_SECURITY_CREDENTIAL= # OR a pre-encrypted security credential (overrides the password above)
# MPESA_CERT=                # Safaricom public certificate (PEM) — optional if using a pre-encrypted credential
